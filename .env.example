# ── PostgreSQL (Neon) ─────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Anthropic (Claude) ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GoHighLevel ───────────────────────────────────────
GHL_API_KEY=your-ghl-api-key
GHL_LOCATION_ID=your-location-id

# ── Security ──────────────────────────────────────────
# Secret token GHL sends in the webhook header so we know it's really GHL
GHL_WEBHOOK_SECRET=make-up-a-random-string-here

# ── Newsletter settings ───────────────────────────────
# Comma-separated topics for Claude to cover each day
NEWSLETTER_TOPICS=AI tools,ChatGPT updates,AI in business,automation news,AI agents

# Send time: cron format  (default = 8:00 AM UTC)
CRON_SCHEDULE=0 8 * * *

# ── Server ────────────────────────────────────────────
PORT=3000
